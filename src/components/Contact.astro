---
---
<section id="contacto">
  <div class="container">
    <h2 class="section-title">Hablemos<span>.</span></h2>
    <p class="section-subtitle">¿Tienes un proyecto en mente? Escríbeme.</p>
    <div class="contact-wrap">
      <form class="form" name="contact" method="POST" data-netlify="true">
        <div class="field">
          <label for="name">Nombre</label>
          <input id="name" name="name" type="text" placeholder="Tu nombre" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" placeholder="tu@email.com" required />
        </div>
        <div class="field">
          <label for="message">Mensaje</label>
          <textarea id="message" name="message" rows="5" placeholder="Cuéntame tu proyecto..." required></textarea>
        </div>
        <button type="submit" class="btn-submit">Enviar mensaje</button>
      </form>
      <aside class="links">
        <p>También puedes encontrarme en:</p>
        <ul>
          <li>
            <a href="https://github.com/WaffPetardosHD" target="_blank" rel="noopener">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.44 9.8 8.2 11.38.6.11.82-.26.82-.58v-2.03c-3.34.72-4.04-1.61-4.04-1.61-.54-1.38-1.33-1.74-1.33-1.74-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.24 1.84 1.24 1.07 1.83 2.8 1.3 3.48.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.12-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 0 1 3-.4c1.02 0 2.04.13 3 .4 2.28-1.55 3.29-1.23 3.29-1.23.66 1.66.24 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.81 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58C20.57 21.8 24 17.3 24 12c0-6.63-5.37-12-12-12z"/></svg>
              GitHub
            </a>
          </li>
          <li>
            <a href="mailto:serhi@example.com">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              Email
            </a>
          </li>
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .contact-wrap {
    display: grid;
    grid-template-columns: 1fr 280px;
    gap: 3rem;
    align-items: start;
  }
  .form { display: flex; flex-direction: column; gap: 1.25rem; }
  .field { display: flex; flex-direction: column; gap: .4rem; }
  label { font-size: .85rem; font-weight: 600; color: var(--text-muted); }
  input, textarea {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: .75rem 1rem;
    color: var(--text);
    font-family: var(--font);
    font-size: .95rem;
    transition: border-color .2s;
    resize: vertical;
  }
  input:focus, textarea:focus { border-color: var(--accent-2); outline: none; }
  .btn-submit {
    align-self: flex-start;
    padding: .75rem 1.75rem;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-weight: 600;
    font-size: .95rem;
    cursor: pointer;
    transition: opacity .2s, transform .2s;
    font-family: var(--font);
  }
  .btn-submit:hover { opacity: .85; transform: translateY(-1px); }

  .links p { color: var(--text-muted); margin-bottom: 1.25rem; }
  .links ul { list-style: none; display: flex; flex-direction: column; gap: .75rem; }
  .links a {
    display: flex;
    align-items: center;
    gap: .6rem;
    color: var(--text-muted);
    font-weight: 500;
    transition: color .2s;
  }
  .links a:hover { color: var(--accent-2); }

  @media (max-width: 768px) {
    .contact-wrap { grid-template-columns: 1fr; }
  }
</style>
